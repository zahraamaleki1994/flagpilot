{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typegen": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "typegen"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
